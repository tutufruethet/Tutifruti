{
  "name": "nexus-os",
  "version": "0.2.0",
  "private": true,
  "description": "Sistema operacional virtual dentro de um quarto 3D.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "serve:static": "node scripts/serve-static.mjs out 4173",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@react-three/drei": "^10.6.0",
    "@react-three/fiber": "^9.3.0",
