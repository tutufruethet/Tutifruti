# Conta na nuvem (opcional). Sem estas variáveis, o NEXUS funciona só com perfis locais.
# A chave anon é pública por desenho; a proteção dos dados é o Row Level Security
# (supabase/migrations). Nunca coloque a chave service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
